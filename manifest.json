{
  "manifest_version": 3,
  "name": "منبه موقع الحساب في اكس",
  "short_name": "X Origin Alert",
  "version": "0.3.0",
  "description": "يعرض دولة كل حساب في اكس بعلمها، ويحذر عند West Asia أو North Africa أو VPN أو كثرة تغيير الاسم. عربي وإنجليزي.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "منبه موقع الحساب"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "countries.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "author": "Sami Al Mohaimeed",
  "homepage_url": "https://github.com/Samix2026/x-origin-alert"
}